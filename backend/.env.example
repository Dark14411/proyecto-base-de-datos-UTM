# ═══════════════════════════════════════════════════════════════
# UTM Desk NoSQL Cloud — Variables de Entorno Backend (Ejemplo)
# ═══════════════════════════════════════════════════════════════

PORT=5000

# MongoDB URI (Atlas o local)
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster0.example.mongodb.net/utm_desk_nosql?retryWrites=true&w=majority
DB_NAME=utm_desk_nosql

# Redis Cloud o Redis Local
REDIS_URL=redis://default:<password>@<host>:<port>
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Frontend URL para CORS
FRONTEND_URL=http://localhost:5173
